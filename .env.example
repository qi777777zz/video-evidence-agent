CONVERSATION_CACHE_KEY_PREFIX=video-agent:conversation
CONVERSATION_CACHE_TTL_SECONDS=3600
CONVERSATION_CONTEXT_MESSAGES=20
# Explicit prompt budgets. Evidence is allocated before recent dialogue and summary.
LLM_INPUT_TOKEN_BUDGET=12000
SYSTEM_PROMPT_TOKEN_BUDGET=512
CONVERSATION_SUMMARY_TOKEN_BUDGET=1200
RECENT_DIALOGUE_TOKEN_BUDGET=2400
CURRENT_QUESTION_TOKEN_BUDGET=600
EVIDENCE_TOKEN_BUDGET=7000
CONVERSATION_SUMMARY_TRIGGER_TOKENS=3200
APP_ENVIRONMENT=development
RATE_LIMIT_KEY_PREFIX=video-agent:rate
# Deprecated migration-only bootstrap. Prefer scripts/api_keys.py; leave empty after provisioning.
API_KEY=
BOOTSTRAP_TENANT_ID=demo
METRICS_TOKEN=
METRICS_ALLOWED_NETWORKS=127.0.0.0/8,::1/128,172.16.0.0/12
WORKER_METRICS_PORT=9091
WEBHOOK_SECRET=change-me
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RESPONSE_BYTES=65536
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MAX_VIDEO_BYTES=2147483648
MAX_VIDEO_SECONDS=10800
# Concurrency values must be between 1 and 64.
TENANT_CONCURRENCY=2
TENANT_QUEUE_QUOTA=20
ASR_CONCURRENCY=1
OCR_CONCURRENCY=2
LLM_CONCURRENCY=2
# Per-minute limits must be between 1 and 10000 (0 does not disable limiting).
UPLOAD_RATE_PER_MINUTE=30
SUBMIT_RATE_PER_MINUTE=10
QUESTION_RATE_PER_MINUTE=60
# Retry delay: 1..3600; evidence count: 1..100; timeouts: 0.1..300 seconds.
RATE_LIMIT_RETRY_SECONDS=60
MAX_EVIDENCE_COUNT=20
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=800
PARSER_VERSION=v1
PROCESSING_MODE=full
ASR_MODEL=small
OCR_MODEL=rapidocr-onnxruntime
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_CACHE_DIR=D:/anew/models
MEDIA_CACHE_DIR=
MEDIA_CACHE_MAX_BYTES=8589934592
RETRIEVAL_KEYWORD_WEIGHT=0.55
RETRIEVAL_VECTOR_WEIGHT=0.45
RETRIEVAL_VECTOR_THRESHOLD=0.58

# Data lifecycle. Original media and derived evidence have independent limits.
LIFECYCLE_INTERVAL_SECONDS=3600
INCOMPLETE_UPLOAD_RETENTION_HOURS=24
FAILED_JOB_RETENTION_DAYS=7
ORIGINAL_RETENTION_DAYS=90
EVIDENCE_RETENTION_DAYS=90
ORPHAN_OBJECT_GRACE_HOURS=24

# Docker Compose infrastructure settings
MYSQL_ROOT_PASSWORD=change-this-root-password
